{
  "name": "vscode-profile-kit",
  "displayName": "Profile Kit",
  "description": "Declare core + per-purpose extension groups once, then create and check VS Code profiles from that preset",
  "version": "0.0.1",
  "preview": true,
  "publisher": "woogajjangka",
  "license": "MIT",
  "author": {
    "name": "siwon Jeon",
    "url": "https://github.com/WoogaJJangka"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WoogaJJangka/vscode-profile-kit.git"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "profiles",
    "extensions",
    "preset"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "profile-kit": "./dist/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Profile Kit",
      "properties": {
        "profileKit.presetPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Preset file (`*.profile-kit.json`) that declares core extensions, groups, profiles and settings. The same file is used in every profile."
        },
        "profileKit.profile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Written by Profile Kit into each profile's own settings: the profile's name, so Profile Kit can tell which profile a window uses. Do not edit."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "profileKit",
          "title": "Profile Kit",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "profileKit": [
        {
          "id": "profileKit.profiles",
          "name": "Profiles",
          "contextualTitle": "Profile Kit"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "profileKit.profiles",
        "contents": "No preset file yet. A preset declares the extensions every profile gets (core), named groups, and profiles built from them.\n[Open Preset File](command:profileKit.openPreset)\n[Create Preset from This Profile](command:profileKit.createPreset)",
        "when": "!profileKit.hasPreset"
      }
    ],
    "commands": [
      {
        "command": "profileKit.showPlan",
        "title": "Show Plan from Preset File",
        "category": "Profile Kit"
      },
      {
        "command": "profileKit.openPreset",
        "title": "Open Preset File...",
        "category": "Profile Kit",
        "icon": "$(folder-opened)"
      },
      {
        "command": "profileKit.createPreset",
        "title": "Create Preset from This Profile...",
        "category": "Profile Kit"
      },
      {
        "command": "profileKit.editPreset",
        "title": "Edit Preset",
        "category": "Profile Kit",
        "icon": "$(edit)"
      },
      {
        "command": "profileKit.refresh",
        "title": "Refresh",
        "category": "Profile Kit",
        "icon": "$(refresh)"
      },
      {
        "command": "profileKit.installMissing",
        "title": "Install Missing Extensions",
        "category": "Profile Kit",
        "icon": "$(cloud-download)"
      },
      {
        "command": "profileKit.installToProfiles",
        "title": "Install to Profiles...",
        "category": "Profile Kit",
        "icon": "$(add)"
      },
      {
        "command": "profileKit.applyProfile",
        "title": "Apply Preset to Profile...",
        "category": "Profile Kit",
        "icon": "$(check)"
      },
      {
        "command": "profileKit.applyAll",
        "title": "Apply Preset to All Profiles...",
        "category": "Profile Kit",
        "icon": "$(check-all)"
      },
      {
        "command": "profileKit.switchProfile",
        "title": "Switch Profile...",
        "category": "Profile Kit",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "profileKit.switchTo",
        "title": "Switch to This Profile",
        "category": "Profile Kit",
        "icon": "$(arrow-swap)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "profileKit.refresh",
          "when": "view == profileKit.profiles",
          "group": "navigation@1"
        },
        {
          "command": "profileKit.installToProfiles",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "navigation@0"
        },
        {
          "command": "profileKit.applyAll",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "navigation@2"
        },
        {
          "command": "profileKit.editPreset",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "navigation@3"
        },
        {
          "command": "profileKit.openPreset",
          "when": "view == profileKit.profiles",
          "group": "1_preset@1"
        },
        {
          "command": "profileKit.createPreset",
          "when": "view == profileKit.profiles",
          "group": "1_preset@2"
        }
      ],
      "view/item/context": [
        {
          "command": "profileKit.installMissing",
          "when": "view == profileKit.profiles && viewItem =~ /:missing\\b/",
          "group": "inline@1"
        },
        {
          "command": "profileKit.switchTo",
          "when": "view == profileKit.profiles && viewItem =~ /^profile:exists\\b/ && viewItem =~ /:other\\b/",
          "group": "inline@2"
        },
        {
          "command": "profileKit.applyProfile",
          "when": "view == profileKit.profiles && viewItem =~ /:declared\\b/",
          "group": "1_apply@1"
        },
        {
          "command": "profileKit.installMissing",
          "when": "view == profileKit.profiles && viewItem =~ /:missing\\b/",
          "group": "1_apply@2"
        },
        {
          "command": "profileKit.switchTo",
          "when": "view == profileKit.profiles && viewItem =~ /^profile:exists\\b/ && viewItem =~ /:other\\b/",
          "group": "2_switch@1"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.profile-kit.json",
        "url": "./schema/preset.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "cli": "node dist/cli.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run typecheck && npm run build:prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
