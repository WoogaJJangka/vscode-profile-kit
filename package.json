{
  "name": "vscode-profile-kit",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.3.0",
  "icon": "media/icon.png",
  "publisher": "woogajjangka",
  "license": "MIT",
  "author": {
    "name": "siwon Jeon",
    "url": "https://github.com/WoogaJJangka"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WoogaJJangka/vscode-profile-kit.git"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "profiles",
    "profile",
    "extensions",
    "extension manager",
    "preset",
    "settings",
    "settings sync",
    "setup"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "bin": {
    "profile-kit": "./dist/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "profileKit.preset": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "scope": "application",
          "markdownDescription": "%config.preset%"
        },
        "profileKit.presetPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "ignoreSync": true,
          "markdownDescription": "%config.presetPath%"
        },
        "profileKit.profile": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.profile%"
        },
        "profileKit.managedKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.managedKeys%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "profileKit",
          "title": "%view.container%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "profileKit": [
        {
          "id": "profileKit.profiles",
          "name": "%view.profiles%",
          "contextualTitle": "%view.container%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome%",
        "when": "!profileKit.hasPreset"
      },
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome.starter.python-data%",
        "when": "!profileKit.hasPreset && profileKit.recommendedStarter == python-data"
      },
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome.starter.web-js%",
        "when": "!profileKit.hasPreset && profileKit.recommendedStarter == web-js"
      },
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome.starter.java%",
        "when": "!profileKit.hasPreset && profileKit.recommendedStarter == java"
      },
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome.starter.c-cpp%",
        "when": "!profileKit.hasPreset && profileKit.recommendedStarter == c-cpp"
      },
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome.starter.csharp%",
        "when": "!profileKit.hasPreset && profileKit.recommendedStarter == csharp"
      },
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome.starter.go%",
        "when": "!profileKit.hasPreset && profileKit.recommendedStarter == go"
      },
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome.starter.rust%",
        "when": "!profileKit.hasPreset && profileKit.recommendedStarter == rust"
      },
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome.starter.docker-infra%",
        "when": "!profileKit.hasPreset && profileKit.recommendedStarter == docker-infra"
      },
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome.starter.all-languages%",
        "when": "!profileKit.hasPreset && profileKit.recommendedStarter == all-languages"
      },
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome.actions%",
        "when": "!profileKit.hasPreset"
      }
    ],
    "walkthroughs": [
      {
        "id": "profileKit.start",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "preset",
            "title": "%walkthrough.preset.title%",
            "description": "%walkthrough.preset.description%",
            "media": {
              "svg": "media/walkthrough/preset.svg",
              "altText": "%walkthrough.preset.alt%"
            },
            "completionEvents": [
              "onContext:profileKit.hasPreset"
            ]
          },
          {
            "id": "apply",
            "title": "%walkthrough.apply.title%",
            "description": "%walkthrough.apply.description%",
            "media": {
              "svg": "media/walkthrough/apply.svg",
              "altText": "%walkthrough.apply.alt%"
            },
            "completionEvents": [
              "onCommand:profileKit.applyAll",
              "onCommand:profileKit.applyProfile"
            ]
          },
          {
            "id": "switch",
            "title": "%walkthrough.switch.title%",
            "description": "%walkthrough.switch.description%",
            "media": {
              "svg": "media/walkthrough/switch.svg",
              "altText": "%walkthrough.switch.alt%"
            },
            "completionEvents": [
              "onCommand:profileKit.menu",
              "onCommand:profileKit.switchProfile"
            ]
          },
          {
            "id": "install",
            "title": "%walkthrough.install.title%",
            "description": "%walkthrough.install.description%",
            "media": {
              "svg": "media/walkthrough/install.svg",
              "altText": "%walkthrough.install.alt%"
            },
            "completionEvents": [
              "onCommand:profileKit.installToProfiles",
              "onCommand:profileKit.openManager"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "profileKit.showPlan",
        "title": "%cmd.showPlan%",
        "category": "%category%"
      },
      {
        "command": "profileKit.openPreset",
        "title": "%cmd.openPreset%",
        "category": "%category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "profileKit.createPreset",
        "title": "%cmd.createPreset%",
        "category": "%category%"
      },
      {
        "command": "profileKit.startFromStarter",
        "title": "%cmd.startFromStarter%",
        "category": "%category%"
      },
      {
        "command": "profileKit.editPreset",
        "title": "%cmd.editPreset%",
        "category": "%category%",
        "icon": "$(edit)"
      },
      {
        "command": "profileKit.storePresetInSettings",
        "title": "%cmd.storePresetInSettings%",
        "category": "%category%",
        "icon": "$(sync)"
      },
      {
        "command": "profileKit.movePresetToFile",
        "title": "%cmd.movePresetToFile%",
        "category": "%category%",
        "icon": "$(file)"
      },
      {
        "command": "profileKit.refresh",
        "title": "%cmd.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "profileKit.installMissing",
        "title": "%cmd.installMissing%",
        "category": "%category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "profileKit.openManager",
        "title": "%cmd.openManager%",
        "category": "%category%",
        "icon": "$(table)"
      },
      {
        "command": "profileKit.installToProfiles",
        "title": "%cmd.installToProfiles%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "profileKit.applyProfile",
        "title": "%cmd.applyProfile%",
        "category": "%category%",
        "icon": "$(check)"
      },
      {
        "command": "profileKit.applyAll",
        "title": "%cmd.applyAll%",
        "category": "%category%",
        "icon": "$(check-all)"
      },
      {
        "command": "profileKit.switchProfile",
        "title": "%cmd.switchProfile%",
        "category": "%category%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "profileKit.switchTo",
        "title": "%cmd.switchTo%",
        "category": "%category%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "profileKit.exportCodeProfile",
        "title": "%cmd.exportCodeProfile%",
        "category": "%category%",
        "icon": "$(export)"
      },
      {
        "command": "profileKit.importCodeProfile",
        "title": "%cmd.importCodeProfile%",
        "category": "%category%"
      },
      {
        "command": "profileKit.menu",
        "title": "%cmd.menu%",
        "category": "%category%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "profileKit.getStarted",
        "title": "%cmd.getStarted%",
        "category": "%category%",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "profileKit.applyAll",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "navigation@0"
        },
        {
          "command": "profileKit.openManager",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "navigation@1"
        },
        {
          "command": "profileKit.refresh",
          "when": "view == profileKit.profiles",
          "group": "navigation@2"
        },
        {
          "command": "profileKit.installToProfiles",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "1_extensions@1"
        },
        {
          "command": "profileKit.editPreset",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "2_preset@1"
        },
        {
          "command": "profileKit.openPreset",
          "when": "view == profileKit.profiles",
          "group": "2_preset@2"
        },
        {
          "command": "profileKit.createPreset",
          "when": "view == profileKit.profiles",
          "group": "2_preset@3"
        },
        {
          "command": "profileKit.startFromStarter",
          "when": "view == profileKit.profiles",
          "group": "2_preset@4"
        },
        {
          "command": "profileKit.importCodeProfile",
          "when": "view == profileKit.profiles",
          "group": "3_share@1"
        },
        {
          "command": "profileKit.exportCodeProfile",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "3_share@2"
        },
        {
          "command": "profileKit.getStarted",
          "when": "view == profileKit.profiles",
          "group": "4_help@1"
        }
      ],
      "view/item/context": [
        {
          "command": "profileKit.installMissing",
          "when": "view == profileKit.profiles && viewItem =~ /:missing\\b/",
          "group": "inline@1"
        },
        {
          "command": "profileKit.switchTo",
          "when": "view == profileKit.profiles && viewItem =~ /^profile:exists\\b/ && viewItem =~ /:other\\b/",
          "group": "inline@2"
        },
        {
          "command": "profileKit.applyProfile",
          "when": "view == profileKit.profiles && viewItem =~ /:declared\\b/",
          "group": "1_apply@1"
        },
        {
          "command": "profileKit.installMissing",
          "when": "view == profileKit.profiles && viewItem =~ /:missing\\b/",
          "group": "1_apply@2"
        },
        {
          "command": "profileKit.switchTo",
          "when": "view == profileKit.profiles && viewItem =~ /^profile:exists\\b/ && viewItem =~ /:other\\b/",
          "group": "2_switch@1"
        },
        {
          "command": "profileKit.exportCodeProfile",
          "when": "view == profileKit.profiles && viewItem =~ /:declared\\b/",
          "group": "3_share@1"
        }
      ],
      "commandPalette": [
        {
          "command": "profileKit.switchTo",
          "when": "false"
        },
        {
          "command": "profileKit.applyAll",
          "when": "profileKit.hasPreset"
        },
        {
          "command": "profileKit.applyProfile",
          "when": "profileKit.hasPreset"
        },
        {
          "command": "profileKit.installMissing",
          "when": "profileKit.hasPreset"
        },
        {
          "command": "profileKit.installToProfiles",
          "when": "profileKit.hasPreset"
        },
        {
          "command": "profileKit.openManager",
          "when": "profileKit.hasPreset"
        },
        {
          "command": "profileKit.editPreset",
          "when": "profileKit.hasPreset"
        },
        {
          "command": "profileKit.exportCodeProfile",
          "when": "profileKit.hasPreset"
        },
        {
          "command": "profileKit.showPlan",
          "when": "profileKit.hasPreset"
        },
        {
          "command": "profileKit.storePresetInSettings",
          "when": "profileKit.hasPreset && !profileKit.presetInSettings"
        },
        {
          "command": "profileKit.movePresetToFile",
          "when": "profileKit.presetInSettings"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.profile-kit.json",
        "url": "./schema/preset.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "build:compat": "node esbuild.mjs --compat",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "cli": "node dist/cli.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run typecheck && npm run build:prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.9"
    }
  }
}
