{
  "name": "vscode-profile-kit",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "preview": true,
  "publisher": "woogajjangka",
  "license": "MIT",
  "author": {
    "name": "siwon Jeon",
    "url": "https://github.com/WoogaJJangka"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WoogaJJangka/vscode-profile-kit.git"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "profiles",
    "extensions",
    "preset"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "bin": {
    "profile-kit": "./dist/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "profileKit.presetPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "%config.presetPath%"
        },
        "profileKit.profile": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.profile%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "profileKit",
          "title": "%view.container%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "profileKit": [
        {
          "id": "profileKit.profiles",
          "name": "%view.profiles%",
          "contextualTitle": "%view.container%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "profileKit.profiles",
        "contents": "%view.welcome%",
        "when": "!profileKit.hasPreset"
      }
    ],
    "commands": [
      {
        "command": "profileKit.showPlan",
        "title": "%cmd.showPlan%",
        "category": "%category%"
      },
      {
        "command": "profileKit.openPreset",
        "title": "%cmd.openPreset%",
        "category": "%category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "profileKit.createPreset",
        "title": "%cmd.createPreset%",
        "category": "%category%"
      },
      {
        "command": "profileKit.editPreset",
        "title": "%cmd.editPreset%",
        "category": "%category%",
        "icon": "$(edit)"
      },
      {
        "command": "profileKit.refresh",
        "title": "%cmd.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "profileKit.installMissing",
        "title": "%cmd.installMissing%",
        "category": "%category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "profileKit.openManager",
        "title": "%cmd.openManager%",
        "category": "%category%",
        "icon": "$(table)"
      },
      {
        "command": "profileKit.installToProfiles",
        "title": "%cmd.installToProfiles%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "profileKit.applyProfile",
        "title": "%cmd.applyProfile%",
        "category": "%category%",
        "icon": "$(check)"
      },
      {
        "command": "profileKit.applyAll",
        "title": "%cmd.applyAll%",
        "category": "%category%",
        "icon": "$(check-all)"
      },
      {
        "command": "profileKit.switchProfile",
        "title": "%cmd.switchProfile%",
        "category": "%category%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "profileKit.switchTo",
        "title": "%cmd.switchTo%",
        "category": "%category%",
        "icon": "$(arrow-swap)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "profileKit.refresh",
          "when": "view == profileKit.profiles",
          "group": "navigation@1"
        },
        {
          "command": "profileKit.installToProfiles",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "navigation@0"
        },
        {
          "command": "profileKit.openManager",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "navigation@1"
        },
        {
          "command": "profileKit.applyAll",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "navigation@2"
        },
        {
          "command": "profileKit.editPreset",
          "when": "view == profileKit.profiles && profileKit.hasPreset",
          "group": "navigation@3"
        },
        {
          "command": "profileKit.openPreset",
          "when": "view == profileKit.profiles",
          "group": "1_preset@1"
        },
        {
          "command": "profileKit.createPreset",
          "when": "view == profileKit.profiles",
          "group": "1_preset@2"
        }
      ],
      "view/item/context": [
        {
          "command": "profileKit.installMissing",
          "when": "view == profileKit.profiles && viewItem =~ /:missing\\b/",
          "group": "inline@1"
        },
        {
          "command": "profileKit.switchTo",
          "when": "view == profileKit.profiles && viewItem =~ /^profile:exists\\b/ && viewItem =~ /:other\\b/",
          "group": "inline@2"
        },
        {
          "command": "profileKit.applyProfile",
          "when": "view == profileKit.profiles && viewItem =~ /:declared\\b/",
          "group": "1_apply@1"
        },
        {
          "command": "profileKit.installMissing",
          "when": "view == profileKit.profiles && viewItem =~ /:missing\\b/",
          "group": "1_apply@2"
        },
        {
          "command": "profileKit.switchTo",
          "when": "view == profileKit.profiles && viewItem =~ /^profile:exists\\b/ && viewItem =~ /:other\\b/",
          "group": "2_switch@1"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.profile-kit.json",
        "url": "./schema/preset.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "cli": "node dist/cli.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run typecheck && npm run build:prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
