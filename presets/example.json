{
  "$schema": "../schema/preset.schema.json",
  "core": [
    "anthropic.claude-code",
    "openai.chatgpt",
    "openai.codex-audio",
    "ms-ceintl.vscode-language-pack-ko",
    "github.github-vscode-theme",
    "woogajjangka.cool-icon-vscode",
    "eamodio.gitlens",
    "mhutchie.git-graph",
    "github.vscode-pull-request-github",
    "codezombiech.gitignore",
    "mccarter.start-git-bash",
    "esbenp.prettier-vscode",
    "usernamehw.errorlens",
    "oderwat.indent-rainbow",
    "albert.tabout",
    "wmaurer.change-case",
    "cardinal90.multi-cursor-case-preserve",
    "alefragnani.project-manager",
    "tomoki1207.pdf",
    "mechatroner.rainbow-csv",
    "sonarsource.sonarlint-vscode",
    "ms-vscode-remote.remote-ssh",
    "ms-vscode-remote.remote-ssh-edit",
    "ms-vscode.remote-explorer",
    "ms-vscode-remote.remote-wsl",
    "be5invis.vscode-custom-css",
    "brandonkirbyson.vscode-animations"
  ],
  "groups": {
    "python-data": [
      "ms-python.python",
      "ms-python.debugpy",
      "ms-python.vscode-pylance",
      "ms-python.vscode-python-envs",
      "charliermarsh.ruff",
      "ms-python.mypy-type-checker",
      "njpwerner.autodocstring",
      "ms-toolsai.jupyter",
      "ms-toolsai.jupyter-keymap",
      "ms-toolsai.jupyter-renderers",
      "ms-toolsai.vscode-jupyter-cell-tags",
      "ms-toolsai.vscode-jupyter-slideshow",
      "ms-toolsai.datawrangler",
      "janisdd.vscode-edit-csv",
      "qwtel.sqlite-viewer"
    ],
    "java": [
      "redhat.java",
      "vscjava.vscode-java-pack",
      "vscjava.vscode-java-debug",
      "vscjava.vscode-java-dependency",
      "vscjava.vscode-java-test",
      "vscjava.vscode-maven",
      "vscjava.migrate-java-to-azure",
      "vscjava.vscode-gradle"
    ],
    "c-cpp": [
      "ms-vscode.cpptools",
      "ms-vscode.cpptools-extension-pack",
      "ms-vscode.cpptools-themes",
      "ms-vscode.cmake-tools",
      "ms-vscode.cpp-devtools",
      "franneck94.c-cpp-runner",
      "vadimcn.vscode-lldb"
    ],
    "web-js": [
      "dbaeumer.vscode-eslint",
      "christian-kohler.npm-intellisense",
      "ecmel.vscode-html-css",
      "ritwickdey.liveserver",
      "unifiedjs.vscode-mdx",
      "xyc.vscode-mdx-preview"
    ],
    "csharp-unity": [
      "ms-dotnettools.csdevkit",
      "ms-dotnettools.csharp",
      "ms-dotnettools.vscode-dotnet-runtime",
      "visualstudiotoolsforunity.vstuc"
    ],
    "go": ["golang.go"],
    "docker-infra": [
      "ms-azuretools.vscode-docker",
      "ms-azuretools.vscode-containers",
      "ms-vscode-remote.remote-containers",
      "confluentinc.vscode-confluent"
    ]
  },
  "profiles": {
    "Core": {},
    "Python-Data": {
      "groups": ["python-data"],
      "match": {
        "languages": ["python", "jupyter"],
        "files": ["pyproject.toml", "requirements.txt", "setup.py", "setup.cfg", "Pipfile", "*.py", "*.ipynb"],
        "keywords": ["python", "jupyter", "notebook", "data science", "pandas"]
      }
    },
    "Java": {
      "groups": ["java"],
      "match": {
        "languages": ["java"],
        "files": ["pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle", "gradlew", "*.java"],
        "keywords": ["java", "maven", "gradle", "spring"]
      }
    },
    "C-Cpp": {
      "groups": ["c-cpp"],
      "match": {
        "languages": ["c", "cpp", "cuda-cpp"],
        "files": ["CMakeLists.txt", "meson.build", "*.c", "*.cpp", "*.cc", "*.h", "*.hpp"],
        "keywords": ["c", "c++", "cpp", "cmake"]
      }
    },
    "Web-JS": {
      "groups": ["web-js"],
      "match": {
        "languages": ["javascript", "typescript", "javascriptreact", "typescriptreact", "html", "css", "mdx"],
        "files": ["package.json", "tsconfig.json", "*.js", "*.ts", "*.html"],
        "keywords": ["javascript", "typescript", "node", "html", "css", "react"]
      }
    },
    "CSharp-Unity": {
      "groups": ["csharp-unity"],
      "match": {
        "languages": ["csharp"],
        "files": ["*.sln", "*.csproj", "*.cs", "ProjectSettings"],
        "keywords": ["c#", "csharp", "dotnet", ".net", "unity"]
      }
    },
    "Go": {
      "groups": ["go"],
      "match": {
        "languages": ["go", "go.mod"],
        "files": ["go.mod", "go.work", "*.go"],
        "keywords": ["go", "golang"]
      }
    },
    "Docker-Infra": {
      "groups": ["docker-infra"],
      "match": {
        "languages": ["dockerfile", "dockercompose"],
        "files": [
          "Dockerfile",
          "compose.yaml",
          "compose.yml",
          "docker-compose.yml",
          "docker-compose.yaml",
          "*.dockerfile",
          ".devcontainer"
        ],
        "keywords": ["docker", "containers", "devcontainer", "kubernetes", "kafka"]
      }
    }
  }
}
