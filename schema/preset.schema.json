{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/WoogaJJangka/vscode-profile-kit/schema/preset.schema.json",
  "title": "Profile Kit preset",
  "description": "Core extensions + named groups + VS Code profiles built from them. Keep in step with the checks in src/core/preset.ts.",
  "type": "object",
  "required": ["profiles"],
  "additionalProperties": false,
  "definitions": {
    "extensionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*\\.[A-Za-z0-9][A-Za-z0-9-]*$",
      "description": "publisher.name, as shown by code --list-extensions"
    },
    "extensionList": {
      "type": "array",
      "items": { "$ref": "#/definitions/extensionId" }
    },
    "settings": {
      "type": "object",
      "description": "settings.json keys and values. Only keys written by Profile Kit are managed; other keys are left alone.",
      "propertyNames": { "minLength": 1, "pattern": "\\S" }
    },
    "nameList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "core": {
      "$ref": "#/definitions/extensionList",
      "description": "Extensions every profile gets (unless skipCore)"
    },
    "groups": {
      "type": "object",
      "description": "Named sets of extensions that profiles pick from",
      "additionalProperties": { "$ref": "#/definitions/extensionList" }
    },
    "settings": {
      "$ref": "#/definitions/settings",
      "description": "Settings written to every declared profile (profiles.X.settings override them)"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "description": "VS Code profiles to create. The Default profile cannot be declared.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$",
        "not": { "pattern": "^[Dd][Ee][Ff][Aa][Uu][Ll][Tt]$" }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "groups": { "type": "array", "items": { "type": "string" } },
          "extensions": { "$ref": "#/definitions/extensionList" },
          "skipCore": { "type": "boolean", "default": false },
          "shareFromDefault": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "settings": { "type": "boolean" },
              "keybindings": { "type": "boolean" },
              "snippets": { "type": "boolean" },
              "tasks": { "type": "boolean" }
            }
          },
          "settings": {
            "$ref": "#/definitions/settings",
            "description": "Settings for this profile only, written over the common settings"
          },
          "match": {
            "type": "object",
            "description": "Signals used to recommend this profile for an extension or a folder",
            "additionalProperties": false,
            "properties": {
              "languages": { "$ref": "#/definitions/nameList", "description": "VS Code language IDs" },
              "files": {
                "type": "array",
                "description": "File or folder names at the top of a folder: exact names or simple globs like *.py",
                "items": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/]*[^\\\\/\\s][^\\\\/]*$" }
              },
              "keywords": { "$ref": "#/definitions/nameList" }
            }
          }
        },
        "if": {
          "required": ["shareFromDefault"],
          "properties": {
            "shareFromDefault": { "required": ["settings"], "properties": { "settings": { "const": true } } }
          }
        },
        "then": {
          "not": { "required": ["settings"] },
          "description": "A profile that shares settings with Default has no settings.json of its own"
        }
      }
    }
  }
}
